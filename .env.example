# ==============================================================================
# HiredeskHR Environment Configuration Template
# Copy this file to .env and provide your actual local or staging credentials.
# NEVER commit .env or real credentials to source control!
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database (Supabase PostgreSQL via Prisma)
# DATABASE_URL uses transaction pooling for regular queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL uses direct connection for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Platform Credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
STORAGE_BUCKET_RESUMES="resumes"

# Platform Super Admin One-Time Bootstrap Secret (REQUIRED in production)
# Must be changed from default 'hiredesk-local-bootstrap-secret' before bootstrapping
BOOTSTRAP_SECRET="generate-a-strong-random-bootstrap-secret-here"

# IMAP Email Ingestion Worker (Gmail / Hostinger / Standard TLS)
# For Gmail: Use imap.gmail.com:993, SSL: true, and a 16-character Google App Password

IMAP_HOST="imap.hostinger.com"
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME="inbound@youragency.com"
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
IMAP_POLL_INTERVAL_MS=30000
IMAP_MAX_RETRIES=8
INBOUND_MAILBOX_ID="primary-hostinger-inbox"

# SMTP Outbound Email Delivery & Calendar Events (Hostinger / Standard TLS)
# If omitted, outbox records are safely created with status: 'failed' (code: 'SMTP_NOT_CONFIGURED')
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME="interviews@youragency.com"
SMTP_PASSWORD=""
SMTP_FROM_NAME="Hiredesk Recruiting Team"
SMTP_FROM_EMAIL="interviews@youragency.com"
APP_PUBLIC_URL="http://localhost:5173"

# Frontend (Vite)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
VITE_API_URL=""
# ↑ Leave empty for local dev (Vite proxy handles /api).
# In production on Vercel, set to your Render backend URL:
#   e.g. https://hiredesk-api.onrender.com

