# ==============================================================================
# HiredeskHR Environment Configuration Template
# Copy this file to .env and provide your actual local or staging credentials.
# NEVER commit .env or real credentials to source control!
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database (Supabase PostgreSQL via Prisma)
# DATABASE_URL uses transaction pooling for regular queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL uses direct connection for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Platform Credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
STORAGE_BUCKET_RESUMES="resumes"

# IMAP Email Ingestion Worker (Hostinger / Standard TLS)
IMAP_HOST="imap.hostinger.com"
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME="inbound@youragency.com"
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
IMAP_POLL_INTERVAL_MS=30000
IMAP_MAX_RETRIES=8
INBOUND_MAILBOX_ID="primary-hostinger-inbox"

# Frontend (Vite)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
VITE_API_URL="http://localhost:4000/api"
