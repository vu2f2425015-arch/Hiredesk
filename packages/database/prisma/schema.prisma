datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  status              String               @default("active")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               UserProfile[]
  clients             Client[]
  jobs                Job[]
  candidates          Candidate[]
  applications        Application[]
  activityLogs        ActivityLog[]

  @@map("organizations")
}

model UserProfile {
  id             String        @id @default(uuid())
  authUserId     String        @unique // Supabase auth.users.id UUID
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String        // super_admin, manager, recruiter, client
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  fullName       String?
  email          String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  stageHistories StageHistory[]

  @@index([authUserId])
  @@index([organizationId])
  @@index([clientId])
  @@index([email])
  @@map("user_profiles")
}

model Client {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactEmail   String
  contactPhone   String?
  status         String         @default("active")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  jobs           Job[]
  userProfiles   UserProfile[]
  applications   Application[]

  @@index([organizationId, name])
  @@map("clients")
}

model Job {
  id                    String        @id @default(uuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId              String
  client                Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  jobCode               String        @unique // Atomic sequence formatted JOB-1001
  title                 String
  department            String?
  employmentType        String        // full_time, part_time, contract, internship
  workplaceModel        String        // remote, on_site, hybrid
  country               String
  currency              String        @default("USD")
  salaryMin             Decimal?      @db.Decimal(12, 2)
  salaryMax             Decimal?      @db.Decimal(12, 2)
  experienceYears       Int           @default(0)
  openings              Int           @default(1)
  deadline              DateTime?
  education             String?
  skills                String[]      @default([])
  description           String        @db.Text
  requirements          String?       @db.Text
  status                String        @default("draft") // draft, published, closed
  applicationFormConfig Json          @default("{}")
  createdBy             String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  applications          Application[]

  @@index([organizationId, status])
  @@index([clientId])
  @@index([jobCode])
  @@map("jobs")
}

model Candidate {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateCode   String
  normalizedEmail String
  name            String
  phone           String?
  location        String?
  country         String?
  skills          String[]      @default([])
  education       Json          @default("[]")
  experience      Json          @default("[]")
  sourceMetadata  Json          @default("{}")
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
  resumes         Resume[]

  @@unique([organizationId, normalizedEmail])
  @@index([organizationId])
  @@map("candidates")
}

model Application {
  id             String         @id @default(uuid())
  candidateId    String
  candidate      Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stage          String         @default("Applied")
  source         String         @default("direct")
  appliedAt      DateTime       @default(now())
  status         String         @default("active")
  answers        Json           @default("{}")
  recruiterNotes String?        @db.Text
  clientFeedback String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resumes        Resume[]
  stageHistories StageHistory[]

  @@unique([jobId, candidateId])
  @@index([organizationId, jobId, stage])
  @@index([clientId, stage])
  @@map("applications")
}

model Resume {
  id               String       @id @default(uuid())
  candidateId      String
  candidate        Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId    String?
  application      Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  bucket           String       @default("resumes")
  storagePath      String
  originalFilename String
  safeFilename     String
  contentType      String
  fileSize         Int
  checksum         String
  extractedText    String?      @db.Text
  parsingStatus    String       @default("pending")
  parsingError     String?
  uploadedAt       DateTime     @default(now())

  @@index([candidateId])
  @@index([applicationId])
  @@index([checksum])
  @@map("resumes")
}

model InboundApplication {
  id                  String    @id @default(uuid())
  mailboxId           String
  uidValidity         BigInt
  uid                 BigInt
  messageId           String?
  subject             String
  senderEmail         String
  senderName          String?
  recipientEmail      String
  receivedAt          DateTime
  extractedJobCode    String?
  matchedJobId        String?
  matchedOrgId        String?
  matchedClientId     String?
  status              String    @default("received")
  failureReason       String?
  attemptCount        Int       @default(0)
  lastAttemptAt       DateTime?
  processedAt         DateTime?
  linkedCandidateId   String?
  linkedApplicationId String?
  rawPayload          Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([mailboxId, uidValidity, uid])
  @@index([status])
  @@index([extractedJobCode])
  @@index([matchedOrgId])
  @@index([messageId])
  @@map("inbound_applications")
}

model StageHistory {
  id            String       @id @default(uuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStage String
  nextStage     String
  actorId       String?
  actor         UserProfile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reason        String?
  timestamp     DateTime     @default(now())

  @@index([applicationId, timestamp])
  @@map("stage_histories")
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  entityType     String
  entityId       String
  action         String
  details        Json         @default("{}")
  visibility     String       @default("internal") // internal, client_visible
  timestamp      DateTime     @default(now())

  @@index([organizationId, timestamp])
  @@index([organizationId, visibility])
  @@map("activity_logs")
}
