{
  "name": "hiredeskhr-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "HiredeskHR — Multi-tenant Applicant Tracking System for recruitment agencies",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@hiredesk/api",
    "dev:worker": "npm run dev --workspace=@hiredesk/worker",
    "dev:web": "npm run dev --workspace=@hiredesk/web",
    "build": "npm run build --workspaces --if-present",
    "vercel-build": "npm run build --workspace=@hiredesk/shared && npm run build --workspace=@hiredesk/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
